generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 1. Tabel Dokter (User Login)
model Doctor {
  id             String   @id @default(uuid())
  email          String   @unique
  medicalId      String?  @unique
  password       String
  fullName       String
  specialization String?  @default("General Practitioner")
  avatarUrl      String?  // Link Foto Profil
  bio            String?  @db.Text // Deskripsi diri panjang
  phone          String?  // Nomor HP
  address        String?  @db.Text // Alamat Dokter/Klinik
  birthDate      DateTime? // Tanggal Lahir Dokter
  gender         String?  // Jenis Kelamin Dokter (Male/Female)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relasi: Dokter punya banyak pasien & konsultasi
  patients       Patient[]
  consultations  Consultation[]
}

// 2. Tabel Pasien
model Patient {
  id            String   @id @default(uuid())
  name          String
  nik           String?  @unique
  gender        String
  birthDate     DateTime?
  address       String?  @db.Text

  // Relasi: Pasien ini dipegang oleh Dokter siapa?
  doctorId      String
  doctor        Doctor   @relation(fields: [doctorId], references: [id])

  // Relasi: Pasien punya banyak riwayat konsultasi
  consultations Consultation[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// 3. Tabel Konsultasi (Rekam Medis)
model Consultation {
  id          String   @id @default(uuid())

  // Data Rekaman Suara
  audioUrl    String?  // Link file audio (nanti disimpan di folder/cloud)
  duration    Int?     // Durasi dalam detik
  transcript  String?  @db.Text // Hasil speech-to-text (Whisper)

  // Hasil Analisa AI (SOAP)
  subjective  String?  @db.Text // Keluhan Pasien
  objective   String?  @db.Text // Hasil Observasi
  assessment  String?  @db.Text // Diagnosa
  plan        String?  @db.Text // Resep/Tindakan

  summary     String?  @db.Text // Ringkasan pendek AI

  status      String   @default("draft") // draft, processing, done

  // Relasi
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id])

  doctorId    String
  doctor      Doctor   @relation(fields: [doctorId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
